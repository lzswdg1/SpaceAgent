    "workspaces": {"type": "integer", "minimum": 0},
    "conversations": {"type": "integer", "minimum": 0},
    "mcpConnections": {"type": "integer", "minimum": 0},
    "knowledgeDocuments": {"type": "integer", "minimum": 0},
    "memories": {"type": "integer", "minimum": 0},
    "automations": {"type": "integer", "minimum": 0},
    "runs": {"type": "integer", "minimum": 0},
    "modelEffects": {"type": "integer", "minimum": 0},
    "toolEffects": {"type": "integer", "minimum": 0}
