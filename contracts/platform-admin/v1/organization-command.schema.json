{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaceagent.local/contracts/platform-admin/v1/organization-command.schema.json",
  "title": "Platform administration Organization command result",
  "type": "object",
  "additionalProperties": false,
  "required": ["commandId", "operation", "state", "result", "createdAt", "updatedAt"],
  "properties": {
    "commandId": {"type": "string", "format": "uuid"},
    "operation": {"enum": ["ORGANIZATION_CREATE", "ORGANIZATION_UPDATE", "ORGANIZATION_DELETE", "ORGANIZATION_MEMBER_ADD", "ORGANIZATION_MEMBER_ROLE_UPDATE", "ORGANIZATION_MEMBER_REMOVE", "ORGANIZATION_OWNER_TRANSFER"]},
    "targetType": {"const": "ORGANIZATION"},
    "targetId": {"type": ["string", "null"], "maxLength": 36},
    "targetUserId": {
      "type": ["string", "null"],
      "maxLength": 36,
      "description": "Compatibility wire field containing the target Organization ID for update/delete."
    },
    "state": {"enum": ["RECEIVED", "DISPATCHING", "SUCCEEDED", "FAILED", "UNKNOWN"]},
    "result": {"type": "object"},
    "safeErrorCode": {"type": ["string", "null"], "maxLength": 80},
    "activationToken": {"type": ["string", "null"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": ["string", "null"], "format": "date-time"}
  }
}
