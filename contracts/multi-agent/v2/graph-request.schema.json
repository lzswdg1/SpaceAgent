{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://spaceagent.dev/contracts/multi-agent/v2/graph-request.schema.json",
  "type":"object","additionalProperties":false,
  "required":["contractVersion","requestId","graphSessionId","agentRunId","tenantId","ownerUserId","bundleHash","cursor","limits"],
  "properties":{
    "contractVersion":{"const":"graph/v2"},"requestId":{"type":"string","minLength":1,"maxLength":200},
    "graphSessionId":{"type":"string","minLength":1},"agentRunId":{"type":"string","minLength":1},
    "tenantId":{"type":"string","minLength":1},"ownerUserId":{"type":"string","minLength":1},
    "bundleHash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "cursor":{"type":"object","additionalProperties":false,"required":["sequence","completedCommandIds","pendingCommandId"],"properties":{"sequence":{"type":"integer","minimum":0},"completedCommandIds":{"type":"array","maxItems":256,"items":{"type":"string","minLength":1,"maxLength":200}},"pendingCommandId":{"type":["string","null"]}}},
    "limits":{"type":"object","additionalProperties":false,"required":["maxDepth","maxAgents","remainingTokenBudget"],"properties":{"maxDepth":{"type":"integer","minimum":1,"maximum":32},"maxAgents":{"type":"integer","minimum":1,"maximum":32},"remainingTokenBudget":{"type":"integer","minimum":0}}}
  }
}
