# Alternative Knowledge backend: existing PostgreSQL/pgvector only, no Milvus service or credentials.
# Combine with the protected release environment; this file is not a complete secret source.
PLATFORM_KNOWLEDGE_VECTOR_STORE_MODE=pgvector
PLATFORM_KNOWLEDGE_PGVECTOR_QUERY_TIMEOUT_SECONDS=5
PLATFORM_KNOWLEDGE_INDEX_INTAKE_ENABLED=false
PLATFORM_KNOWLEDGE_INDEX_WORKER_ENABLED=false
# Small-server operators may deliberately run the indexing worker in the API process.
# Do not start an additional knowledge-worker JVM for that configuration.
PLATFORM_KNOWLEDGE_MAX_PENDING=8
PLATFORM_KNOWLEDGE_MAX_SOURCE_BYTES=268435456
# Text/Markdown are local; binary parsing requires the optional isolated Tika service.
PLATFORM_KNOWLEDGE_PARSER_URI=
