discovery.docker "spaceagent" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "spaceagent_logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "spaceagent" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.spaceagent.targets
  labels        = { platform = "docker" }
  relabel_rules = discovery.relabel.spaceagent_logs.rules
  forward_to    = [loki.write.local.receiver]
}

local.file_match "spaceagent_local" {
  path_targets = [{
    "__path__" = "/var/log/spaceagent/*.log",
    "platform" = "local",
  }]
  sync_period = "5s"
}

loki.source.file "spaceagent_local" {
  targets    = local.file_match.spaceagent_local.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
