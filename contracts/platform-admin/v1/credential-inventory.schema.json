{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaceagent.local/contracts/platform-admin/v1/credential-inventory.schema.json",
  "title": "Redacted platform credential inventory page",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "page", "pageSize", "total", "generatedAt"],
  "properties": {
    "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/credential"}},
    "page": {"type": "integer", "minimum": 0},
    "pageSize": {"type": "integer", "minimum": 1, "maximum": 100},
    "total": {"type": "integer", "minimum": 0},
    "generatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "organizationId", "ownerUserId", "name", "authType", "secretConfigured", "status", "metadata"],
      "properties": {
        "kind": {"enum": ["PROVIDER", "AGENT_KEY", "MCP"]},
        "id": {"type": "string"},
        "organizationId": {"type": "string"},
        "ownerUserId": {"type": "string"},
        "subjectId": {"type": ["string", "null"]},
        "name": {"type": "string"},
        "baseUrl": {"type": ["string", "null"]},
        "endpointHost": {"type": ["string", "null"]},
        "authType": {"type": "string"},
        "secretConfigured": {"type": "boolean"},
        "secretHint": {"type": ["string", "null"], "maxLength": 40},
        "secretFingerprint": {"type": ["string", "null"], "maxLength": 64},
        "secretKeyVersion": {"type": ["string", "null"], "maxLength": 32},
        "status": {"type": "string"},
        "observedAt": {"type": ["string", "null"], "format": "date-time"},
        "metadata": {"type": "object"}
      }
    }
  }
}
