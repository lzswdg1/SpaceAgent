# Development/test dependencies only. Use ignored .env.rag for actual values.
# Official multi-architecture manifest verified from Docker Hub on 2026-09-14 (amd64/arm64).
MILVUS_IMAGE=milvusdb/milvus:v2.6.22@sha256:a8ac051e59eb084d41bd317ec51aac28553d664e91c43a806ccd6a1538abc1df
MILVUS_BOOTSTRAP_PASSWORD=
MILVUS_HOST_PORT=19530
MILVUS_HEALTH_PORT=19091

# Host-run platform configuration; default application mode stays disabled until explicitly configured.
PLATFORM_KNOWLEDGE_VECTOR_STORE_MODE=milvus
PLATFORM_KNOWLEDGE_INDEX_CONTENT_ROOT=data/knowledge-index
# Enable intake/indexing only after the selected backend, current migrations and recovery checks are ready.
PLATFORM_KNOWLEDGE_INDEX_INTAKE_ENABLED=false
PLATFORM_KNOWLEDGE_INDEX_WORKER_ENABLED=false
PLATFORM_KNOWLEDGE_MILVUS_URI=http://127.0.0.1:19530
PLATFORM_KNOWLEDGE_MILVUS_TOKEN=
PLATFORM_KNOWLEDGE_MILVUS_DATABASE=default
PLATFORM_KNOWLEDGE_MILVUS_COLLECTION_PREFIX=spaceagent
PLATFORM_KNOWLEDGE_MILVUS_ALLOW_INSECURE_LOCAL=true
