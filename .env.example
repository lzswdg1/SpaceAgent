# SpaceAgent local development configuration template.
# Copy to .env and replace every placeholder before starting platform-server.

# PostgreSQL
DB_USERNAME=spaceagent
DB_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST_PORT=5436

# Optional independent Platform Administration service (Compose profile: admin)
ADMIN_DB_NAME=spaceagent_admin
ADMIN_DB_USERNAME=spaceagent_admin
ADMIN_DB_PASSWORD=replace-with-a-distinct-admin-database-password
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_HOST_PORT=9400
ADMIN_JWT_ISSUER=spaceagent-platform-admin
ADMIN_JWT_AUDIENCE=spaceagent-platform-admin-api
ADMIN_JWT_SECRET=replace-with-a-distinct-admin-jwt-secret-at-least-32-chars
ADMIN_COOKIE_SECURE=false
# Required on every Admin startup. No TOTP, recovery codes or one-time enable flag.
# Password: 14+ characters, uppercase/lowercase/digit/symbol. Never commit actual credentials.
# Changes synchronize the existing singleton and revoke old sessions after restart.
ADMIN_LOGIN=
ADMIN_DISPLAY_NAME=Platform Administrator
ADMIN_PASSWORD=
ADMIN_PLATFORM_CLIENT_BASE_URL=http://platform-server:9000
# Local Compose only. Production requires HTTPS with a client certificate.
SYSTEM_ADMIN_ALLOW_INSECURE_LOCAL=true
SYSTEM_ADMIN_JWT_ISSUER=spaceagent-platform-admin
SYSTEM_ADMIN_JWT_AUDIENCE=spaceagent-platform-admin-internal
SYSTEM_ADMIN_JWT_SECRET=replace-with-a-distinct-system-admin-service-jwt-secret-at-least-32-chars
PLATFORM_USER_DELETION_ENABLED=false

# Active platform security and release policy
JWT_SECRET=replace-with-a-secure-random-string-at-least-32-chars
INTERNAL_SERVICE_TOKEN=replace-with-a-secure-internal-token-at-least-32-chars
IDENTITY_ACTIVITY_HASH_KEY=replace-with-a-distinct-activity-hmac-key-at-least-32-chars
IDENTITY_PRESENCE_RETENTION_HOURS=24
IDENTITY_PRESENCE_SWEEP_BATCH_SIZE=1000
IDENTITY_PRESENCE_SWEEP_DELAY_MS=60000
PLATFORM_ALLOW_INSECURE_LOCAL=false
PLATFORM_BIND_ADDRESS=127.0.0.1

# Provider and Knowledge Embedding
MODEL_PROVIDER_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
MODEL_PROVIDER_PREVIOUS_ENCRYPTION_KEYS=
MODEL_PROVIDER_ALLOWED_HOSTS=dashscope.aliyuncs.com,*.maas.aliyuncs.com,api.deepseek.com,api.openai.com
MODEL_PROVIDER_ALLOW_LOCALHOST=false
OPENAI_API_KEY=replace-with-your-chat-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_EMBEDDING_API_KEY=replace-with-your-embedding-api-key
AI_EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_EMBEDDING_MODEL=text-embedding-v4

# MCP credentials
MCP_CONNECTION_ENCRYPTION_KEY=replace-with-a-secure-random-string-at-least-32-chars
MCP_CONNECTION_PREVIOUS_ENCRYPTION_KEYS=
MCP_ALLOWED_HOSTS=api.githubcopilot.com,github.com
MCP_REGISTRY_BASE_URL=https://registry.modelcontextprotocol.io
MCP_REGISTRY_WORKER_ENABLED=true

# Official GitHub remote MCP OAuth
GITHUB_MCP_CLIENT_ID=
GITHUB_MCP_CLIENT_SECRET=
GITHUB_MCP_ALLOWED_REDIRECT_URIS=
GITHUB_MCP_SCOPES=repo,read:user,read:org

# Optional first pre-registered generic MCP OAuth client profile
MCP_OAUTH_REGISTRATION_ID=
MCP_OAUTH_AUTHORIZATION_SERVER=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_CLIENT_AUTHENTICATION_METHOD=CLIENT_SECRET_POST
MCP_OAUTH_SCOPES=
MCP_OAUTH_ALLOWED_REDIRECT_URIS=

# Optional orchestration boundaries
MULTI_AGENT_ORCHESTRATOR_INTERNAL_TOKEN=replace-with-a-distinct-multi-agent-token-at-least-32-chars
MULTI_AGENT_ORCHESTRATOR_MODE=none
MULTI_AGENT_ORCHESTRATOR_BASE_URL=http://host.docker.internal:9300
MULTI_AGENT_REASONING_MODE=deterministic
CHAT_AUTOMATIC_PLANNING_ENABLED=false

# Optional Web Search through an operator-managed SearXNG JSON endpoint
TOOLING_WEB_SEARCH_MODE=none
TOOLING_WEB_SEARCH_BASE_URL=

# Optional OCI sandbox worker
SANDBOX_MODE=in-process
SANDBOX_BASE_URL=http://sandbox-worker:9200
SANDBOX_INTERNAL_TOKEN=replace-with-a-secure-sandbox-token-at-least-32-chars
ARTIFACT_OBJECT_MODE=local
ARTIFACT_OBJECT_ENDPOINT=
ARTIFACT_OBJECT_ACCESS_KEY=
ARTIFACT_OBJECT_SECRET_KEY=
ARTIFACT_OBJECT_BUCKET=spaceagent-artifacts
ARTIFACT_OBJECT_ENCRYPTION_REFERENCE=tenant-key:v1
ARTIFACT_OBJECT_MAXIMUM_OBJECT_BYTES=536870912
ARTIFACT_OBJECT_MAXIMUM_ACTIVE_STAGING_SESSIONS_PER_USER=10
ARTIFACT_OBJECT_MAXIMUM_ACTIVE_STAGING_BYTES_PER_USER=1073741824
ARTIFACT_OBJECT_MAXIMUM_ACTIVE_STAGING_SESSIONS_PER_TENANT=100
ARTIFACT_OBJECT_MAXIMUM_ACTIVE_STAGING_BYTES_PER_TENANT=10737418240
ARTIFACT_OBJECT_MAXIMUM_STORED_BYTES_PER_TENANT=53687091200
KNOWLEDGE_URL_REFRESH_LEASE_SECONDS=300
PROJECT_INTAKE_WORKER_ENABLED=true
PROJECT_INTAKE_POLL_DELAY_MS=1000
PROJECT_INTAKE_LEASE_SECONDS=900
PROJECT_INTAKE_MAXIMUM_ATTEMPTS=3
PROJECT_CODING_WORKER_ENABLED=true
PROJECT_CODING_POLL_DELAY_MS=1000
PROJECT_CODING_LEASE_SECONDS=900
PROJECT_CODING_MAXIMUM_ATTEMPTS=3
PROJECT_CODING_MAXIMUM_ITERATIONS=20
PROJECT_CODING_MAXIMUM_REVIEW_ROUNDS=2
SANDBOX_CONTAINER_USER=999:999
SANDBOX_MAX_CONCURRENT_EXECUTIONS=4
SANDBOX_OCI_RUNTIME=

# Optional Web and observability profiles
WEB_HOST_PORT=8080
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-local-observability-password
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
GRAFANA_HOST_PORT=3000
LOKI_HOST_PORT=3100
TEMPO_HOST_PORT=3200
OTLP_HTTP_HOST_PORT=4318
# Prometheus and SQL-backed Agent metrics are always local. OTLP export remains explicit opt-in;
# enable it only when Tempo or another reviewed collector endpoint is running.
PLATFORM_OBSERVABILITY_TRACING_ENABLED=true
PLATFORM_OBSERVABILITY_TRACING_SAMPLING_PROBABILITY=0.10
PLATFORM_OBSERVABILITY_OTLP_ENABLED=false
PLATFORM_OBSERVABILITY_OTLP_ENDPOINT=http://tempo:4318/v1/traces
PLATFORM_OBSERVABILITY_OPERATIONAL_METRICS_ENABLED=true
PLATFORM_OBSERVABILITY_OPERATIONAL_METRICS_WINDOW=5m
PLATFORM_OBSERVABILITY_OPERATIONAL_METRICS_REFRESH_DELAY_MS=15000
