{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaceagent.local/contracts/platform-admin/v1/administrator-recovery-code-rotation.schema.json",
  "title": "Singleton administrator recovery-code rotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["recoveryCodes", "generatedAt"],
  "properties": {
    "recoveryCodes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 8, "maxLength": 64}
    },
    "generatedAt": {"type": "string", "format": "date-time"}
  }
}
