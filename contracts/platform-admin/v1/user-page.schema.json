{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaceagent.local/contracts/platform-admin/v1/user-page.schema.json",
  "title": "Platform administration user page",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "page", "pageSize", "total", "generatedAt"],
  "properties": {
    "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/user"}},
    "page": {"type": "integer", "minimum": 0},
    "pageSize": {"type": "integer", "minimum": 1, "maximum": 100},
    "total": {"type": "integer", "minimum": 0},
    "generatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primaryOrganizationId", "loginName", "displayName", "status", "mustChangePassword", "createdAt", "updatedAt", "successfulLoginCount", "activeRefreshSessions", "membershipCount"],
      "properties": {
        "id": {"type": "string", "maxLength": 36},
        "primaryOrganizationId": {"type": "string", "maxLength": 36},
        "loginName": {"type": "string", "maxLength": 255},
        "displayName": {"type": "string", "maxLength": 120},
        "status": {"enum": ["PENDING_ACTIVATION", "ACTIVE", "SUSPENDED", "DELETION_PENDING", "DELETED"]},
        "mustChangePassword": {"type": "boolean"},
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "lastLoginAt": {"type": ["string", "null"], "format": "date-time"},
        "lastSeenAt": {"type": ["string", "null"], "format": "date-time"},
        "successfulLoginCount": {"type": "integer", "minimum": 0},
        "activeRefreshSessions": {"type": "integer", "minimum": 0},
        "membershipCount": {"type": "integer", "minimum": 0}
      }
    }
  }
}
