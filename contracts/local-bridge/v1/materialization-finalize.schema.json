{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaceagent.dev/contracts/local-bridge/v1/materialization-finalize.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "sessionId", "requestId", "manifestSha256"],
  "properties": {
    "contractVersion": {"const": "local-materialization/v1"},
    "sessionId": {"type": "string", "minLength": 1, "maxLength": 200},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 200},
    "manifestSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
