# Settings overlay; also supply protected release.env with all real secrets. Do not use placeholders live.
# Build and publish/load these images elsewhere. No server-side Maven/npm/Docker builds.
PLATFORM_SERVER_IMAGE=registry.example.invalid/spaceagent/platform-server:release
PLATFORM_ADMIN_SERVER_IMAGE=registry.example.invalid/spaceagent/platform-admin-server:release
WEB_IMAGE=registry.example.invalid/spaceagent/web:release
ADMIN_WEB_IMAGE=registry.example.invalid/spaceagent/admin-web:release
SANDBOX_WORKER_IMAGE=registry.example.invalid/spaceagent/sandbox-worker:release
ADMIN_DB_PASSWORD=replace-with-distinct-16-plus-random-characters
ADMIN_JWT_SECRET=replace-with-distinct-32-plus-random-characters
ADMIN_LOGIN=local-admin
ADMIN_PASSWORD=replace-with-distinct-16-plus-random-characters
ADMIN_PLATFORM_CLIENT_BASE_URL=https://platform-internal.example.invalid
# Keep production private mTLS/TLS setup in an operator-managed overlay; never weaken it for low RAM.
# Export LOW_RESOURCE_TLS_OVERLAY=/absolute/operator-tls.yml when calling the deployment wrapper.
# It is intentionally not sourced from this file as shell code.
# New deployment or existing pgvector-bound DB only; cannot silently switch a Milvus-bound DB.
PLATFORM_KNOWLEDGE_VECTOR_STORE_MODE=pgvector
PLATFORM_KNOWLEDGE_INDEX_INTAKE_ENABLED=false
PLATFORM_KNOWLEDGE_INDEX_WORKER_ENABLED=false
# To enable new text/Markdown indexing, explicitly set both true; this resumes eligible pending work.
# Index worker runs in the API JVM. Do not select the independent knowledge-worker profile here.
PLATFORM_KNOWLEDGE_MAX_PENDING=8
PLATFORM_KNOWLEDGE_MAX_SOURCE_BYTES=268435456
# Binary parsing remains optional: external protected HTTPS Tika, not a local heavy parser process.
PLATFORM_KNOWLEDGE_PARSER_URI=
PLATFORM_KNOWLEDGE_PARSER_ALLOW_PRIVATE_HTTP=false
