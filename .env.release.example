# Copy to .env.release, replace every placeholder, and keep that file outside Git.
DB_USERNAME=spaceagent
DB_PASSWORD=replace-with-at-least-16-random-characters
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
IDENTITY_ACTIVITY_HASH_KEY=replace-with-at-least-32-random-characters
SYSTEM_ADMIN_JWT_SECRET=replace-with-at-least-32-random-characters
SYSTEM_ADMIN_ALLOW_INSECURE_LOCAL=false
PLATFORM_USER_DELETION_ENABLED=true
MULTI_AGENT_ORCHESTRATOR_INTERNAL_TOKEN=
MULTI_AGENT_ORCHESTRATOR_MODE=none
# Independent administrator credentials required by the release profile.
# Keep on every restart; password-only login, no TOTP. Use a strong unique password.
ADMIN_DB_NAME=spaceagent_admin
ADMIN_DB_USERNAME=spaceagent_admin
ADMIN_DB_PASSWORD=replace-with-at-least-16-random-characters
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_HOST_PORT=9400
ADMIN_WEB_BIND_ADDRESS=127.0.0.1
ADMIN_WEB_HOST_PORT=5174
ADMIN_JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_COOKIE_SECURE=true
ADMIN_LOGIN=replace-with-admin-login
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_DISPLAY_NAME=Platform Administrator
ADMIN_PLATFORM_CLIENT_BASE_URL=replace-with-private-https-platform-url
MULTI_AGENT_ORCHESTRATOR_BASE_URL=http://host.docker.internal:9300
MULTI_AGENT_REASONING_MODE=deterministic
CHAT_AUTOMATIC_PLANNING_ENABLED=false
MODEL_PROVIDER_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
MCP_CONNECTION_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
TOOLING_WEB_SEARCH_MODE=none
TOOLING_WEB_SEARCH_BASE_URL=
SANDBOX_MODE=in-process
SANDBOX_INTERNAL_TOKEN=
ARTIFACT_OBJECT_MODE=local
ARTIFACT_OBJECT_ENDPOINT=
ARTIFACT_OBJECT_ACCESS_KEY=
ARTIFACT_OBJECT_SECRET_KEY=
ARTIFACT_OBJECT_BUCKET=spaceagent-artifacts
ARTIFACT_OBJECT_ENCRYPTION_REFERENCE=tenant-key:v1
PROJECT_INTAKE_WORKER_ENABLED=true
PROJECT_INTAKE_POLL_DELAY_MS=1000
PROJECT_INTAKE_LEASE_SECONDS=900
PROJECT_INTAKE_MAXIMUM_ATTEMPTS=3
PROJECT_CODING_WORKER_ENABLED=true
PROJECT_CODING_POLL_DELAY_MS=1000
PROJECT_CODING_LEASE_SECONDS=900
PROJECT_CODING_MAXIMUM_ATTEMPTS=3
PROJECT_CODING_MAXIMUM_ITERATIONS=20
PROJECT_CODING_MAXIMUM_REVIEW_ROUNDS=2
SANDBOX_OCI_RUNTIME=
SANDBOX_CONTAINER_USER=999:999
SANDBOX_MAX_CONCURRENT_EXECUTIONS=4
PLATFORM_OBSERVABILITY_TRACING_ENABLED=true
PLATFORM_OBSERVABILITY_TRACING_SAMPLING_PROBABILITY=0.10
PLATFORM_OBSERVABILITY_OTLP_ENABLED=false
PLATFORM_OBSERVABILITY_OTLP_ENDPOINT=http://tempo:4318/v1/traces
PLATFORM_OBSERVABILITY_OPERATIONAL_METRICS_ENABLED=true
PLATFORM_OBSERVABILITY_OPERATIONAL_METRICS_WINDOW=5m
PLATFORM_OBSERVABILITY_OPERATIONAL_METRICS_REFRESH_DELAY_MS=15000
GITHUB_MCP_CLIENT_ID=
GITHUB_MCP_CLIENT_SECRET=
GITHUB_MCP_ALLOWED_REDIRECT_URIS=
GITHUB_MCP_SCOPES=repo,read:user,read:org
MCP_OAUTH_REGISTRATION_ID=
MCP_OAUTH_AUTHORIZATION_SERVER=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_CLIENT_AUTHENTICATION_METHOD=CLIENT_SECRET_POST
MCP_OAUTH_SCOPES=
MCP_OAUTH_ALLOWED_REDIRECT_URIS=
MCP_REGISTRY_BASE_URL=https://registry.modelcontextprotocol.io
MCP_REGISTRY_WORKER_ENABLED=true
AI_EMBEDDING_API_KEY=replace-with-real-embedding-provider-key
# M79: after explicit copy/rebuild and Agent collection bindings, disable legacy global embedding.
PLATFORM_KNOWLEDGE_LEGACY_MODE=compatibility
PLATFORM_KNOWLEDGE_VECTOR_STORE_MODE=none
PLATFORM_KNOWLEDGE_MILVUS_URI=
PLATFORM_KNOWLEDGE_MILVUS_TOKEN=
PLATFORM_KNOWLEDGE_MILVUS_ALLOW_INSECURE_LOCAL=false
PLATFORM_KNOWLEDGE_INDEX_INTAKE_ENABLED=false
PLATFORM_KNOWLEDGE_INDEX_WORKER_ENABLED=false
PLATFORM_KNOWLEDGE_MAX_DOCUMENTS=10000
PLATFORM_KNOWLEDGE_MAX_PENDING=64
PLATFORM_KNOWLEDGE_MAX_SOURCE_BYTES=1073741824
PLATFORM_RERANKER_MODE=none
PLATFORM_RERANKER_URI=
PLATFORM_RERANKER_TOKEN=
PLATFORM_RERANKER_MODEL=
PLATFORM_RERANKER_REVISION=
PLATFORM_RERANKER_ALLOW_PRIVATE_HTTP=false
SPACEAGENT_RELEASE_VERSION=1.0.0-rc1
PLATFORM_BIND_ADDRESS=127.0.0.1
MODEL_PROVIDER_ALLOWED_HOSTS=api.openai.com,api.deepseek.com,dashscope.aliyuncs.com,*.maas.aliyuncs.com
PLATFORM_RELEASE_MODE=trusted-beta
PLATFORM_TRUSTED_CODE_ONLY=true
PLATFORM_PUBLIC_UNTRUSTED_CODE_ENABLED=false
PLATFORM_ALLOW_INSECURE_LOCAL=false
