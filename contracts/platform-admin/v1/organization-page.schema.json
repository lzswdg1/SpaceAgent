{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaceagent.local/contracts/platform-admin/v1/organization-page.schema.json",
  "title": "Platform administration organization page",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "page", "pageSize", "total", "generatedAt"],
  "properties": {
    "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/organization"}},
    "page": {"type": "integer", "minimum": 0},
    "pageSize": {"type": "integer", "minimum": 1, "maximum": 100},
    "total": {"type": "integer", "minimum": 0},
    "generatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slug", "status", "activeMembers", "createdAt", "updatedAt"],
      "properties": {
        "id": {"type": "string", "maxLength": 36},
        "name": {"type": "string", "maxLength": 120},
        "slug": {"type": "string", "maxLength": 63},
        "status": {"enum": ["ACTIVE", "SUSPENDED", "DELETING", "DELETED"]},
        "creatorUserId": {"type": ["string", "null"]},
        "creatorDisplayName": {"type": ["string", "null"]},
        "activeMembers": {"type": "integer", "minimum": 0},
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "deletionRequestedAt": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
